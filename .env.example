# ==============================================================================
# OrthoFlow — Production & Development Environment Template
# ==============================================================================
# Copy this file to `.env` or reference it when configuring Render and Vercel.
# NEVER commit the real `.env` or any production secrets to Git.
# ==============================================================================

# ==============================================================================
# 1. BACKEND SERVICE (Configured on Render)
# ==============================================================================

# --- Runtime Configuration ---
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
LOG_LEVEL=info

# Number of trusted reverse-proxy hops.
# Render uses 1 proxy hop. Set to 1 in production.
TRUST_PROXY_HOPS=1

# In-memory rate limiter replica constraint (default: 1)
API_REPLICA_COUNT=1
SHUTDOWN_GRACE_MS=30000

# --- Database (MongoDB Atlas) ---
# Format: mongodb+srv://<username>:<password>@<cluster-address>/orthoflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/orthoflow?retryWrites=true&w=majority
MONGODB_DB_NAME=orthoflow
MONGODB_TRANSACTIONS_ENABLED=true

# --- Staff Authentication & JWT Secrets ---
# Minimum 32 characters each. Must be distinct random strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=your-secure-production-jwt-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=your-secure-production-jwt-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=orthoflow-api
JWT_AUDIENCE=orthoflow-app

# --- Patient Portal Authentication ---
# Minimum 32 characters each. Must be distinct from staff secrets.
PORTAL_JWT_ACCESS_SECRET=your-secure-production-portal-access-secret-32-chars
PORTAL_JWT_REFRESH_SECRET=your-secure-production-portal-refresh-secret-32-chars
PORTAL_JWT_ACCESS_EXPIRES_IN=15m
PORTAL_JWT_REFRESH_EXPIRES_IN=30d
PORTAL_JWT_AUDIENCE=orthoflow-portal
PORTAL_INVITATION_EXPIRES_IN=48h

# --- Media & Document Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_FOLDER=orthoflow

# --- Clients & CORS ---
# Must be HTTPS in production. Matches your Vercel deployment URL.
FRONTEND_URL=https://orthoflow.vercel.app
# Optional comma-separated list of additional allowed origins (e.g. custom domain):
# CORS_ADDITIONAL_ORIGINS=https://app.orthoflow.clinic
CORS_ADDITIONAL_ORIGINS=

# --- Security Hardening ---
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
SLOW_REQUEST_THRESHOLD_MS=500
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# --- API Documentation ---
# Swagger UI is automatically disabled in production unless explicitly enabled.
SWAGGER_ENABLED=false

# --- Super Admin Bootstrap ---
# Restrict initial Super Admin creation to this email address (optional)
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# --- Transactional Email (SMTP) ---
# Example: SendGrid, Resend SMTP, AWS SES, or Google Workspace
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-or-api-key
SMTP_FROM_ADDRESS=noreply@orthoflow.clinic
SMTP_FROM_NAME=OrthoFlow

# Verification & Recovery Code Pepper
AUTH_CODE_SECRET=your-secure-production-auth-code-secret-min-32-chars
AUTH_CODE_EXPIRES_IN=10m
AUTH_CODE_RESEND_COOLDOWN=1m
AUTH_CODE_MAX_ATTEMPTS=5

# --- Background Workers ---
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_CONDITION_SWEEP_INTERVAL_MS=900000

COMMUNICATION_WORKER_ENABLED=true
COMMUNICATION_WORKER_INTERVAL_MS=5000
COMMUNICATION_REMINDER_SWEEP_INTERVAL_MS=300000
COMMUNICATION_PAYLOAD_SECRET=your-secure-production-communication-payload-secret-32-chars

# ==============================================================================
# 2. FRONTEND (Configured on Vercel)
# ==============================================================================
# The frontend Angular application uses environment files built into the bundle.
# In production, either:
# - API requests are proxied through Vercel rewrites (relative: /api/v1)
# - OR API requests target the Render Web Service directly:
# API_BASE_URL=https://orthoflow-api.onrender.com/api/v1
