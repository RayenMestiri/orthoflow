# ---------------------------------------------------------------------------
# OrthoFlow backend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Every variable below is validated at boot by src/config/env.ts.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
# Number of trusted reverse-proxy hops; production must set this explicitly.
TRUST_PROXY_HOPS=0
# The in-memory rate limiter intentionally supports one API replica only.
API_REPLICA_COUNT=1
SHUTDOWN_GRACE_MS=30000

# --- Database (MongoDB Atlas) ----------------------------------------------
# Must be a mongodb:// or mongodb+srv:// connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orthoflow?retryWrites=true&w=majority
MONGODB_DB_NAME=orthoflow
# Multi-document transactions require a replica set (Atlas provides one).
# Set to false only when running against a standalone mongod.
MONGODB_TRANSACTIONS_ENABLED=true

# --- Authentication --------------------------------------------------------
# Use long random values (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets MUST be different.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-value-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=orthoflow-api
JWT_AUDIENCE=orthoflow-app
PORTAL_JWT_ACCESS_SECRET=change-me-portal-access-secret-at-least-32-characters
PORTAL_JWT_REFRESH_SECRET=change-me-portal-refresh-secret-at-least-32-characters
PORTAL_JWT_ACCESS_EXPIRES_IN=15m
PORTAL_JWT_REFRESH_EXPIRES_IN=30d
PORTAL_JWT_AUDIENCE=orthoflow-portal
PORTAL_INVITATION_EXPIRES_IN=48h

# --- Media storage (Cloudinary) --------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=orthoflow

# --- Clients / CORS --------------------------------------------------------
FRONTEND_URL=http://localhost:4200
# Optional comma-separated list of extra allowed origins.
CORS_ADDITIONAL_ORIGINS=

# --- Hardening -------------------------------------------------------------
# Max request body size in bytes (default 1 MiB).
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
SLOW_REQUEST_THRESHOLD_MS=500
MEDIA_SIGNED_URL_TTL_SECONDS=900

# --- API docs --------------------------------------------------------------
# Swagger UI is served at /docs outside production and always disabled in production.
SWAGGER_ENABLED=true

# --- Platform bootstrap ----------------------------------------------------
# When set, only this email may create the very first SUPER_ADMIN account.
# Leave empty to allow open self-service clinic registration.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# --- Transactional email ---------------------------------------------------
# Gmail example: smtp.gmail.com, port 465 with SMTP_SECURE=true, using an app
# password. Keep credentials in the deployment secret store, never in Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=OrthoFlow
# Separate pepper for hashing short-lived verification/recovery codes.
AUTH_CODE_SECRET=change-me-to-a-third-long-random-secret-min-32-chars
AUTH_CODE_EXPIRES_IN=10m
AUTH_CODE_RESEND_COOLDOWN=1m
AUTH_CODE_MAX_ATTEMPTS=5

# --- Internal communication worker ----------------------------------------
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_CONDITION_SWEEP_INTERVAL_MS=900000

# --- External transactional communication ---------------------------------
COMMUNICATION_WORKER_ENABLED=true
COMMUNICATION_WORKER_INTERVAL_MS=5000
COMMUNICATION_REMINDER_SWEEP_INTERVAL_MS=300000
# Encrypts short-lived delivery-only values stored in Mongo job payloads.
COMMUNICATION_PAYLOAD_SECRET=change-me-communication-payload-secret-min-32-chars
