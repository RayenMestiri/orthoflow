# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# test output
coverage/

# secrets — NEVER commit real credentials
.env
.env.*
!.env.example

# patient data — NEVER commit clinical files
# Binaries belong in the storage provider, never on our disk or in git. A
# previous revision wrote uploads here; the directory stays ignored so a stray
# clinical photo can never reach the repository.
uploads/

# logs
logs/
*.log
npm-debug.log*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
